# Copy to .env.portable. Requires Docker Compose >= 2.30 (raw env_file).
# Raw values: no surrounding quotes. URL-encode special characters in passwords.
# Obtain the existing URL privately; retain SSL verification and this CA path.
DATABASE_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/defaultdb?ssl-mode=VERIFY_IDENTITY&ssl-ca=/etc/secrets/ca.pem
APP_VERSION=portable
GIT_COMMIT_SHA=replace-with-deployed-commit
DATABASE_BACKUP_POLICY=not_configured
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-privately
GEMINI_TIMEOUT_MS=15000
MARKET_OVERVIEW_CACHE_TTL_SECONDS=900
