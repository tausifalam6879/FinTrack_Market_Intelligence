# Copy to .env only for local Docker Compose overrides. Do not commit real keys.
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5433
API_PORT=8002
GATEWAY_PORT=8081
MLFLOW_PORT=5000
APP_VERSION=compose-local
GIT_COMMIT_SHA=local
DATABASE_BACKUP_POLICY=local-development
# Compose uses PostgreSQL, so readiness must reject accidental SQLite fallback.
REQUIRE_DURABLE_DATABASE=true

# Optional local hybrid mode. Docker Desktop reaches Windows Ollama through host.docker.internal.
LLM_PROVIDER=hybrid
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=8000
GEMINI_CIRCUIT_COOLDOWN_SECONDS=10
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_MS=20000
OLLAMA_KEEP_ALIVE=30m

# SEC asks automated clients to identify the application and monitored contact.
SEC_USER_AGENT=FinTrack Market Intelligence your-email@example.com
