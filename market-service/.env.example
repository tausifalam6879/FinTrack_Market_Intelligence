LLM_PROVIDER=gemini
# Leave LLM_PROVIDER empty for immediate deterministic evidence synthesis.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-with-a-new-server-side-key
LLM_TIMEOUT_MS=12000
MARKET_CACHE_TTL_SECONDS=120
MARKET_QUOTE_CACHE_TTL_SECONDS=15
MARKET_OVERVIEW_CACHE_TTL_SECONDS=900
DATABASE_URL=sqlite:///data/fintrack.db
MODEL_ARTIFACT_DIR=artifacts
MLFLOW_TRACKING_URI=sqlite:///absolute/path/to/market-service/data/mlflow.db
MLFLOW_ARTIFACT_ROOT=file:///absolute/path/to/market-service/data/mlartifacts
MLFLOW_EXPERIMENT_NAME=fintrack-market-models
MLFLOW_REQUIRED=false
RAG_USE_LLM=false
RAG_EMBEDDING_TIMEOUT_MS=30000
# SEC fair-access policy requires a descriptive User-Agent with a monitored contact email.
SEC_USER_AGENT=FinTrack Market Intelligence your-email@example.com
