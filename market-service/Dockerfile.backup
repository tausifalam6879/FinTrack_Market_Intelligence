FROM mysql:8.4-oraclelinux9
USER root
RUN microdnf install -y python3 python3-pip \
    && microdnf clean all \
    && python3 -m pip install --no-cache-dir google-cloud-storage==2.19.0 \
    && mysqldump --version
COPY cloud_backup.py /opt/cloud_backup.py
USER mysql
ENTRYPOINT ["python3", "/opt/cloud_backup.py"]
