# Build the normal API image first, then add verified models using a PRIVATE
# build context prepared by scripts/prepare_model_mirror.py. Never push this
# resulting image to a public registry.
ARG BASE_IMAGE=fintrack-market-base:recovery
FROM ${BASE_IMAGE}
COPY --chown=10001:10001 models/ /app/artifacts/
ENV MODEL_ARTIFACT_DIR=/app/artifacts \
    MODEL_ARTIFACT_BUCKET=fintrack-models-304232323336 \
    MODEL_ARTIFACT_PREFIX=models/ \
    MODEL_ARTIFACT_OFFLINE_ONLY=true
