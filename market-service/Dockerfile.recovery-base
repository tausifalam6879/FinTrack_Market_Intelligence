# Reuse a locally verified runtime when the package index is unavailable.
# This does not publish an image or change the standard production Dockerfile.
ARG BASE_RUNTIME=fintrack-rehearsal-api:local
FROM ${BASE_RUNTIME}
WORKDIR /app
COPY --chown=10001:10001 app.py runtime_health.py runtime_metrics.py market_intelligence.py agent_orchestrator.py company_catalog.py persistence.py data_pipeline.py data_operations.py operations_pipeline.py monitoring_job.py offline_training.py deep_learning.py experiment_tracking.py model_registry.py model_monitoring.py drift_monitoring.py document_rag.py official_documents.py sec_filings.py ./
COPY --chown=10001:10001 research_backtest.py event_impact.py artifact_storage.py request_budget.py preparation_queue.py ./
RUN python -m pip check && python -c "import importlib.metadata as m; assert m.version('scikit-learn') == '1.6.1'; assert m.version('fastapi') == '0.115.6'; assert m.version('yfinance') == '0.2.66'"
